      "id": "b70d5bc0-1e27-4747-8165-b3e17d8509e1",
      "name": "Get Doctors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        220
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "numberInputs": 3
      },
      "id": "ec149bfc-5381-41b7-820c-95ef6d2e7cfe",
      "name": "Merge Context",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        660,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine everything the AI needs: current session state, the raw\n// message, and the clinic's real services/doctors (never let the AI\n// invent a service or doctor name - doc section 19 rule 1).\nconst session = $('Get Active Session').first().json;\nconst services = $('Get Services').first().json;\nconst doctors = $('Get Doctors').first().json;\nconst extracted = $('Extract Message').first().json;\n\nconst systemPrompt = `You are a WhatsApp appointment booking assistant for a clinic.\n\nSTRICT RULES (never break these):\n1. Never invent availability or say a time is free unless it came from a CHECK_AVAILABILITY tool result you were given.\n2. Never say an appointment is booked/confirmed. Only the backend confirms bookings.\n3. Only reference services and doctors from the provided lists - never invent one.\n4. Collect info conversationally, one or two questions at a time. Don't ask for something already present in currentSession.\n5. If the patient's message is ambiguous (e.g. 'evening'), ask them to confirm a specific time rather than guessing.\n\nGiven the conversation state below, decide the next action and reply text.\nRespond with ONLY valid JSON, no markdown fences, no preamble, in this exact shape:\n{\n  \\\"reply_to_patient\\\": string,\n  \\\"session_updates\\\": { \\\"intent\\\"?: string, \\\"serviceId\\\"?: number, \\\"doctorId\\\"?: number, \\\"appointmentDate\\\"?: \\\"YYYY-MM-DD\\\", \\\"selectedStartTime\\\"?: \\\"HH:mm\\\", \\\"patientName\\\"?: string, \\\"state\\\": string },\n  \\\"action\\\": \\\"ASK_MORE_INFO\\\" | \\\"CHECK_AVAILABILITY\\\" | \\\"CONFIRM_BOOKING\\\" | \\\"NONE\\\"\n}\n\nValid state values: STARTED, COLLECTING_SERVICE, COLLECTING_DOCTOR, COLLECTING_DATE, SHOWING_SLOTS, WAITING_FOR_SLOT, COLLECTING_NAME, CONFIRMING, BOOKED.\nUse action=CHECK_AVAILABILITY once service+doctor+date are all known and state should move to SHOWING_SLOTS.\nUse action=CONFIRM_BOOKING only after the patient has explicitly confirmed (e.g. replied 'yes') to a summary you already showed them, with state=CONFIRMING.`;\n\nconst userPrompt = JSON.stringify({\n  currentSession: session,\n  patientMessage: extracted.messageText,\n  availableServices: services,\n  availableDoctors: doctors\n}, null, 2);\n\nreturn [{ json: { systemPrompt, userPrompt, session, extracted } }];"
      },
      "id": "a212eef4-8e32-478d-a810-f95b4d8c844e",
      "name": "Build AI Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-sonnet-4-6',\n  max_tokens: 600,\n  system: $json.systemPrompt,\n  messages: [{ role: 'user', content: $json.userPrompt }]\n}) }}",
        "options": {}
      },
      "id": "d765db23-d55b-4073-a02d-f171fd34a1ca",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.content?.[0]?.text || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { reply_to_patient: \"Sorry, could you rephrase that?\", session_updates: { state: 'STARTED' }, action: 'NONE' };\n}\nconst session = $('Build AI Prompt').first().json.session;\nconst extracted = $('Build AI Prompt').first().json.extracted;\nreturn [{ json: { ...parsed, sessionId: session.sessionId, clinicId: extracted.clinicId, whatsappNumber: extracted.whatsappNumber } }];"
      },
      "id": "cde82055-9fbc-4575-afa3-f0a1df08f45e",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        60
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.SPRING_BOOT_BASE_URL || 'http://localhost:8080'}}/api/sessions/{{$json.sessionId}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.session_updates) }}",
        "options": {}
      },
      "id": "844f4325-d6f0-42a7-a0db-7b10c5d9a729",
      "name": "Update Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        60
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "output": "={{$('Parse AI Response').item.json.action}}",
        "rules": {
          "values": [
            {
              "outputKey": "CHECK_AVAILABILITY"
            },
            {
              "outputKey": "CONFIRM_BOOKING"
            },
            {
              "outputKey": "ASK_MORE_INFO"
            },
            {
              "outputKey": "NONE"
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "0c49d64c-3c00-4dd7-98e8-7d588e6a29d0",
      "name": "Route On Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1760,
        60
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SPRING_BOOT_BASE_URL || 'http://localhost:8080'}}/api/clinics/{{$('Parse AI Response').item.json.clinicId}}/availability",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "doctorId",
              "value": "={{$('Parse AI Response').item.json.session_updates.doctorId}}"
            },
            {
              "name": "serviceId",
              "value": "={{$('Parse AI Response').item.json.session_updates.serviceId}}"
            },
            {
