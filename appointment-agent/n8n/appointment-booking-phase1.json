      "id": "b6c0c16e-6655-4265-911f-5908d4dc9ffb",
      "name": "Get Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -140
      ]
    },
    {
      "parameters": {
        "jsCode": "// NEVER let the AI freehand this list - doc section 19 rule 1.\nconst slots = $json.slots || [];\nconst date = $json.date;\nlet text;\nif (slots.length === 0) {\n  text = `No slots are available on ${date}. Could you try another date?`;\n} else {\n  text = `Available on ${date}: ${slots.join(', ')}. Which time would you prefer?`;\n}\nreturn [{ json: { replyText: text, whatsappNumber: $('Parse AI Response').first().json.whatsappNumber } }];"
      },
      "id": "b2a641ca-e1d0-4e2b-a45d-7d65620a3856",
      "name": "Format Slots Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SPRING_BOOT_BASE_URL || 'http://localhost:8080'}}/api/appointments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  clinicId: $('Parse AI Response').item.json.clinicId,\n  doctorId: $('Build AI Prompt').item.json.session.doctorId,\n  serviceId: $('Build AI Prompt').item.json.session.serviceId,\n  patientName: $('Build AI Prompt').item.json.session.patientName,\n  whatsappNumber: $('Parse AI Response').item.json.whatsappNumber,\n  appointmentDate: $('Build AI Prompt').item.json.session.appointmentDate,\n  startTime: $('Build AI Prompt').item.json.session.selectedStartTime,\n  idempotencyKey: $('Extract Message').item.json.whatsappMessageId || $execution.id,\n  sessionId: $('Parse AI Response').item.json.sessionId\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "6c536acd-6334-4fe6-8234-ad0a72099c52",
      "name": "Create Appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$statusCode}}",
