      "id": "9527dd6f-8df5-492c-a363-a62d9348376d",
      "name": "Booking Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2200,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const a = $json;\nconst text = `Your appointment is confirmed!\\n\\nAppointment ID: ${a.appointmentId}\\nDoctor: ${a.doctorName}\\nService: ${a.serviceName}\\nDate: ${a.appointmentDate}\\nTime: ${a.startTime}`;\nreturn [{ json: { replyText: text, whatsappNumber: $('Parse AI Response').first().json.whatsappNumber } }];"
      },
      "id": "68b61825-8c54-4d27-9fac-100d7a85c432",
      "name": "Format Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SPRING_BOOT_BASE_URL || 'http://localhost:8080'}}/api/clinics/{{$('Parse AI Response').item.json.clinicId}}/availability",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "doctorId",
              "value": "={{$('Build AI Prompt').item.json.session.doctorId}}"
            },
            {
              "name": "serviceId",
              "value": "={{$('Build AI Prompt').item.json.session.serviceId}}"
            },
            {
              "name": "date",
              "value": "={{$('Build AI Prompt').item.json.session.appointmentDate}}"
            }
