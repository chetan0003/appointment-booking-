{
  "name": "AI Appointment Booking Agent - Phase 1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "43937c01-d99d-458e-b880-3c9b3be80c27",
      "name": "WhatsApp Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Meta Cloud API envelope: entry[].changes[].value.{messages[], statuses[]}\nconst body = $input.first().json.body ?? $input.first().json;\nconst value = body.entry?.[0]?.changes?.[0]?.value;\nconst message = value?.messages?.[0];\n\n// Status callbacks (sent/delivered/read) also hit this webhook - ignore them here.\nif (!message) {\n  return [];\n}\n\nconst phone = message.from; // e.g. '919876543210', no '+'\nconst text = message.type === 'text' ? message.text.body\n           : message.type === 'button' ? message.button.text\n           : message.type === 'interactive' ? (message.interactive?.button_reply?.title || message.interactive?.list_reply?.title)\n           : '';\nconst messageId = message.id; // used as the idempotency key downstream\nconst contactName = value.contacts?.[0]?.profile?.name;\n\nreturn [{ json: {\n  clinicId: 1,\n  whatsappNumber: '+' + phone,\n  messageText: text,\n  waMessageId: messageId,\n  contactName\n} }];"
      },
      "id": "cf347041-d249-4b8e-b62f-d7eeaa3be751",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SPRING_BOOT_BASE_URL || 'http://localhost:8080'}}/api/clinics/{{$json.clinicId}}/sessions/active",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "whatsappNumber",
