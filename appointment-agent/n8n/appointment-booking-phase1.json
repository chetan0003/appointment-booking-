      "id": "e472628e-2789-4f21-9012-9a5becfe56cd",
      "name": "Get Fresh Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// The doc's exact scenario from section 15: slot was taken between\n// showing it and confirming. Never say 'booked' here - offer alternatives.\nconst slots = $json.slots || [];\nconst text = slots.length\n  ? `Sorry, that time was just booked by someone else. Other options: ${slots.join(', ')}. Which would you like?`\n  : `Sorry, that time was just booked and there are no other slots that day. Could you try a different date?`;\nreturn [{ json: { replyText: text, whatsappNumber: $('Parse AI Response').first().json.whatsappNumber } }];"
      },
      "id": "d85ea147-8812-4689-b78a-f0515b7526c2",
      "name": "Format Slot Taken Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
