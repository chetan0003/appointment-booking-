    {
      "parameters": {
        "jsCode": "// Process all items returned from the HTTP Request node\nreturn $input.all().map(item => {\n  const a = item.json;\n  const dateObj = new Date(a.appointmentDate + 'T00:00:00');\n  const dateLabel = dateObj.toLocaleDateString('en-IN', { weekday: 'long', month: 'long', day: 'numeric' });\n  const [h, m] = a.startTime.split(':').map(Number);\n  const hour12 = h % 12 || 12;\n  const timeLabel = `${hour12}:${String(m).padStart(2, '0')} ${h >= 12 ? 'PM' : 'AM'}`;\n\n  return {\n    json: {\n      ...a,\n      dateLabel,\n      timeLabel\n    }\n  };\n});"
      },
